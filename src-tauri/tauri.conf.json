{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightNote",
  "version": "0.1.0",
  "identifier": "com.zxinl.LightNote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LightNote - 轻笺",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown file"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Text Document",
        "description": "Text file"
      }
    ],
    "windows": {
      "wix": {
        "template": "installer/wix-template.wxs",
        "fragmentPaths": [
          "installer/wix-context-menu.wxs"
        ],
        "componentGroupRefs": [
          "LightNoteContextMenuComponents"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/nsis-template.nsi",
        "installerHooks": "installer/nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
