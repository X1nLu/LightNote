{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightNote",
  "version": "0.1.0",
  "identifier": "com.zxinl.LightNote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:14200",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/prepare-windows-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LightNote",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown file"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Text Document",
        "description": "Text file"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English", "SimpChinese"],
        "template": "installer/nsis-template.nsi",
        "installerHooks": "installer/nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
